# Copy to backend/.env (gitignored) and adjust. All vars are prefixed WI_ except ANTHROPIC_API_KEY.

WI_ENVIRONMENT=development
WI_CORS_ORIGINS=["http://localhost:5173"]

# --- Optional LLM layer (agents upgrade to claude-opus-4-8 with structured outputs) ---
WI_LLM_ENABLED=false
WI_LLM_MODEL=claude-opus-4-8
# ANTHROPIC_API_KEY=sk-ant-...

# --- Optional true LangGraph StateGraph execution ---
WI_USE_LANGGRAPH=false

# --- Optional PostgreSQL persistence (omit for in-memory) ---
# WI_DATABASE_URL=postgresql+asyncpg://wi:wi@localhost:5432/wi

# --- Optional OpenTelemetry export (in-memory recorder works without these) ---
WI_OTEL_ENABLED=false
# WI_OTEL_ENDPOINT=localhost:4317
WI_SERVICE_NAME=workflow-intel
